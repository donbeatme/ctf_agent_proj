# External services remain disabled until their API keys are configured.
CTF_AUDIT_MODE=online
CTF_AUDIT_DATA_DIR=./data

# LangSmith logging
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ctf-agent-audit
LANGSMITH_WORKSPACE_ID=

# DeepSeek: AgentEvals judge, Reflexion, and agent LLM calls
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# RAGFlow HTTP API
RAGFLOW_ENABLED=true
RAGFLOW_API_KEY=ragflow-A3qqu6NFPpoOdyljWEHKH2kgqW_5EOq1h8WW4F8ilrg
RAGFLOW_BASE_URL=http://localhost
RAGFLOW_DATASET_NAME=ctf-agent
RAGFLOW_TIMEOUT_SECONDS=60
EXPERIENCE_SEARCH_LIMIT=5
RAGFLOW_OBSERVABILITY=true
